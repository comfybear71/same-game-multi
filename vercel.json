{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/games/[id]/predict/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/games/[id]/top10/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-fixtures",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/settle-results",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/backtest-strategy",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/harvest-odds",
      "schedule": "0 10 * * 3"
    },
    {
      "path": "/api/cron/harvest-odds",
      "schedule": "0 10 * * 5"
    },
    {
      "path": "/api/cron/harvest-odds",
      "schedule": "0 0 * * 6"
    },
    {
      "path": "/api/cron/refresh-live-stats",
      "schedule": "*/2 * * * *"
    }
  ]
}
